# Copy to .env.local for local development (never commit real values).
# Only PUBLIC values belong here. The app refuses to start with a secret or
# service-role key.
#
# Supabase Dashboard → Project Settings → API (Data API):
#   Project URL      → VITE_SUPABASE_URL
#   Publishable key  → VITE_SUPABASE_PUBLISHABLE_KEY  (sb_publishable_… or the legacy "anon" key)
#
# Leave both empty to run the Stage-1 prototype with local mock data only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
